{
  "expo": {
    "name": "lyproj-client",
    "slug": "lyproj-client",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "com.parth.lyproj"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "FINAURA needs access to your photos so you can set a profile picture."
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-secure-store",
      "expo-splash-screen",
      "expo-status-bar",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "FINAURA uses the microphone so you can speak to the assistant.",
          "speechRecognitionPermission": "FINAURA turns what you say into text for the assistant.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "userInterfaceStyle": "automatic"
  }
}
