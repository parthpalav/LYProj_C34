# ==============================================================================
# FINAURA Server Environment Configuration Template
# ==============================================================================
# Copy this file to server/.env and provide real credentials.
# NEVER commit the real server/.env to version control.

# Server Configuration (Optional, default: 4000)
PORT=4000
NODE_ENV=development

# Database (Optional in dev, defaults to mongodb://127.0.0.1:27017/lyproj)
# REQUIRED under NODE_ENV=production (must not be localhost)
MONGO_URI=mongodb://127.0.0.1:27017/lyproj

# JWT Secret (STRICTLY REQUIRED in all environments)
# Must be at least 32 characters long. Placeholder or default values will be rejected.
# Example generator: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_key_at_least_32_characters_long

# CORS Allowed Origins (Comma-separated)
# Optional in dev (defaults to http://localhost:5173,http://127.0.0.1:5173)
# REQUIRED under NODE_ENV=production
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Password Hashing Cost (Optional, default: 10)
BCRYPT_ROUNDS=10

# Machine Learning Microservice URL (Optional, default: http://localhost:5001)
ML_SERVICE_URL=http://localhost:5001

# Google Gemini AI API (Optional — AI features degrade gracefully if unset)
GEMINI_API_KEY=

# Email / SMTP Configuration (Optional — fallback logs reset tokens safely to console)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="FINAURA Security <no-reply@finaura.app>"
APP_BASE_URL=http://localhost:4000
