# Server Configuration
PORT=4000
NODE_ENV=development

# Database (Authoritative lyproj MongoDB Database)
MONGO_URI=mongodb://127.0.0.1:27017/lyproj

# JWT & Authentication Secrets
JWT_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=10

# Machine Learning Microservice
ML_SERVICE_URL=http://localhost:5001

# Google Gemini AI API
GEMINI_API_KEY=your_gemini_api_key_here

# Email / SMTP Configuration (Optional: fallback logs tokens to console)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="FINAURA Security <no-reply@finaura.app>"
APP_BASE_URL=http://localhost:4000
